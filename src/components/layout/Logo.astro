---
// Logo Component - Horizontal Layout with fixed spacing
---
<a href="/" class="flex items-center gap-3 group">
  <!-- Left Side: Microphone & Treble Clef Graphic -->
  <div class="text-gold group-hover:text-offwhite transition-colors duration-300">
    <svg width="50" height="50" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Microphone Body -->
      <rect x="60" y="10" width="20" height="40" rx="10" fill="currentColor" opacity="0.8"/>
      <!-- Microphone Grill Lines -->
      <line x1="65" y1="15" x2="75" y2="15" stroke="#080B14" stroke-width="2"/>
      <line x1="65" y1="20" x2="75" y2="20" stroke="#080B14" stroke-width="2"/>
      <line x1="65" y1="25" x2="75" y2="25" stroke="#080B14" stroke-width="2"/>
      <line x1="65" y1="30" x2="75" y2="30" stroke="#080B14" stroke-width="2"/>
      <line x1="65" y1="35" x2="75" y2="35" stroke="#080B14" stroke-width="2"/>
      <!-- Microphone Stand -->
      <path d="M70 50 V 80 M 55 80 H 85" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
      <!-- Treble Clef -->
      <path d="M30 80 C 10 80, 10 50, 25 40 C 35 32, 45 40, 35 50 C 25 60, 15 45, 20 30 C 25 15, 45 10, 45 30 C 45 50, 30 60, 30 80" stroke="currentColor" stroke-width="4" stroke-linecap="round" fill="none"/>
    </svg>
  </div>

  <!-- Right Side: Text and Banner -->
  <div class="flex flex-col items-start gap-1">
    <!-- Main Name -->
    <span class="font-serif text-3xl font-bold text-gold italic leading-none group-hover:text-offwhite transition-colors duration-300">
      Stoms
    </span>
    <!-- Red "Music Studio" Banner -->
    <div class="bg-red-700 text-white text-[8px] font-bold tracking-[0.2em] uppercase px-1.5 py-0.5 rounded-sm border border-red-500/50 shadow-sm">
      Music Studio
    </div>
  </div>
</a>