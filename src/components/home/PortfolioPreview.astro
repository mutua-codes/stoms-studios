---
// Selected Portfolio Preview
---
<section class="py-24 bg-charcoal text-offwhite">
  <div class="max-w-6xl mx-auto px-4 text-center">
    <h2 class="text-3xl md:text-4xl font-serif font-bold mb-4">Selected Portfolio</h2>
    <p class="text-offwhite/60 mb-12 max-w-2xl mx-auto">A glimpse into our recent projects across photography, events, and creative work.</p>
    
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <!-- Using the first 3 real images -->
      <div class="aspect-square bg-midnight rounded-sm overflow-hidden border border-white/5 hover:border-gold/50 transition-colors cursor-pointer">
        <img src="/images/gallery-1.jpg" alt="Portfolio Photo 1" class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-500" />
      </div>
      <div class="aspect-square bg-midnight rounded-sm overflow-hidden border border-white/5 hover:border-gold/50 transition-colors cursor-pointer">
        <img src="/images/gallery-2.jpg" alt="Portfolio Photo 2" class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-500" />
      </div>
      <div class="aspect-square bg-midnight rounded-sm overflow-hidden border border-white/5 hover:border-gold/50 transition-colors cursor-pointer">
        <img src="/images/gallery-3.jpg" alt="Portfolio Photo 3" class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-500" />
      </div>
    </div>
    
    <a href="/portfolio" class="inline-block mt-12 text-gold border-b border-gold pb-1 hover:text-offwhite hover:border-offwhite transition-colors font-bold uppercase tracking-wide text-sm">
      View Full Portfolio &rarr;
    </a>
  </div>
</section>