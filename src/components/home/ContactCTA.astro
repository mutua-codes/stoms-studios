---
// Contact Call to Action
---
<section id="contact" class="py-24 bg-charcoal text-offwhite text-center border-t border-white/5">
  <div class="max-w-3xl mx-auto px-4">
    <h2 class="text-3xl md:text-5xl font-serif font-bold mb-6">Ready to work with us?</h2>
    <p class="text-offwhite/70 mb-10 text-lg">
      Whether you're booking a photo shoot, recording a track, or planning a live stream, let's make it happen.
    </p>
    
    <div class="flex flex-col sm:flex-row justify-center gap-6 items-center">
      <!-- Link to the Contact Page -->
      <a href="/contact" class="bg-gold text-midnight w-full sm:w-auto px-8 py-4 rounded-sm font-bold text-lg hover:bg-offwhite transition-colors flex items-center justify-center gap-2">
        Send a WhatsApp Enquiry
      </a>
      
      <!-- Or call directly -->
      <a href="tel:0703227541" class="border border-gold text-gold w-full sm:w-auto px-8 py-4 rounded-sm font-bold text-lg hover:bg-gold/10 transition-colors flex items-center justify-center gap-2">
        Call 0703 227 541
      </a>
    </div>
    
    <!-- Keep the second number and location below -->
    <div class="mt-8 space-y-2">
      <p class="text-sm text-offwhite/70">
        Alternative line: <a href="tel:0726217507" class="hover:text-gold transition-colors">0726 217 507</a>
      </p>
      <p class="text-sm text-offwhite/50">
        Visit us: Kilungya Street, opposite Parkside Hotel, Kitui Town.
      </p>
    </div>
  </div>
</section>