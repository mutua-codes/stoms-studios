---
// Services Section
---
<section class="py-24 bg-midnight text-offwhite min-h-screen">
  <div class="max-w-6xl mx-auto px-4 text-center">
    <h2 class="text-4xl md:text-5xl font-serif font-bold mb-6">Our <span class="text-gold">Services</span></h2>
    <p class="text-offwhite/60 mb-16 max-w-2xl mx-auto text-lg">
      From professional photography to full audiovisual production, we have the gear, the team, and the expertise to handle your project.
    </p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Photography -->
      <div class="bg-charcoal p-10 rounded-sm border border-white/5 hover:border-gold/50 transition-all duration-300 group text-left">
        <h3 class="text-2xl font-serif text-gold mb-4 group-hover:text-offwhite transition-colors">Photography</h3>
        <p class="text-offwhite/60 leading-relaxed">Events, portraits, graduations, and commercial shoots. We capture the perfect moment with professional lighting and high-resolution editing.</p>
      </div>
      
      <!-- Videography -->
      <div class="bg-charcoal p-10 rounded-sm border border-white/5 hover:border-gold/50 transition-all duration-300 group text-left">
        <h3 class="text-2xl font-serif text-gold mb-4 group-hover:text-offwhite transition-colors">Videography</h3>
        <p class="text-offwhite/60 leading-relaxed">Cinematic event coverage, music videos, and documentaries. We bring your story to life with dynamic camera work and professional editing.</p>
      </div>
      
      <!-- Music Audiovisual -->
      <div class="bg-charcoal p-10 rounded-sm border border-white/5 hover:border-gold/50 transition-all duration-300 group text-left">
        <h3 class="text-2xl font-serif text-gold mb-4 group-hover:text-offwhite transition-colors">Music Audiovisual</h3>
        <p class="text-offwhite/60 leading-relaxed">Professional recording, mixing, and visual production. Our studio is equipped with top-tier audio gear and experienced producers.</p>
      </div>
      
      <!-- Drone Services -->
      <div class="bg-charcoal p-10 rounded-sm border border-white/5 hover:border-gold/50 transition-all duration-300 group text-left">
        <h3 class="text-2xl font-serif text-gold mb-4 group-hover:text-offwhite transition-colors">Drone Services</h3>
        <p class="text-offwhite/60 leading-relaxed">Aerial photography and videography for a unique perspective. Perfect for outdoor events, real estate, and landscape shots.</p>
      </div>
      
      <!-- Livestream Services -->
      <div class="bg-charcoal p-10 rounded-sm border border-white/5 hover:border-gold/50 transition-all duration-300 group text-left md:col-span-2 lg:col-span-1">
        <h3 class="text-2xl font-serif text-gold mb-4 group-hover:text-offwhite transition-colors">Livestream Services</h3>
        <p class="text-offwhite/60 leading-relaxed">High-quality broadcasting for events, church services, and concerts. Reach a wider audience with smooth, reliable streaming.</p>
      </div>
    </div>
  </div>
</section>